      "parameters": {
        "jsCode": "const payload = $input.first().json;\n\n// UTF-8 safe base64 encoding (handles accented characters in partner names etc.)\nconst jsonString = JSON.stringify(payload);\nconst base64Request = Buffer.from(jsonString, 'utf-8').toString('base64');\n\nreturn [{\n  json: {\n    request: base64Request\n  }\n}];"
      },
