    {
      "parameters": {
        "jsCode": "const row = $('Edit Fields - Combine data').item.json;\nconst token = $('using token').item.json.token;\nconst companyVat = $('using token').item.json.vat;\n\n// --- Date logic (web form branch: issue=today, completion=today, due=issue+5) ---\nconst now = new Date();\nconst completionDate = new Date(now); // date_of_delivery = today\nconst dueDate = new Date(now);\ndueDate.setDate(dueDate.getDate() + 5); // payment_deadline = today + 5\n\nconst fmt = (d) => d.toISOString().split('T')[0]; // YYYY-MM-DD\n\n// --- Amount from web form ---\nconst netAmount = row['Give net amount in USD'];\n\n// --- Build nested payload per doc structure ---\nconst fullPayload = {\n  token: token,\nvat: companyVat, // your own company adószám, from 'SLM API' table\n  data: {\n    head: {\n      SLM_partner_data: row.SLM_partner_data,\n      sync_partner_data: row.sync_partner_data,\n      partner: {\n        name: row.partner_name,\n        vat: row.partner_vat,\n        eu_vat: row.partner_eu_vat,\n        address: {\n          zip: row.partner_address_zip,\n          city: row.partner_address_city,\n          street: row.partner_address_street,\n          number: row.partner_address_number,\n          country: row.partner_address_country\n        },\n        email: row.partner_email\n      },\n      storno: false,\n      payment_method: row.payment_method,\n      date_of_delivery: fmt(completionDate),\n      payment_deadline: fmt(dueDate),\n      creation_date: fmt(now),\n      gross_amount: \"\",\n      currency: row.currency,\n      exchange_rate: row.exchange_rate,\n      bank_account: row.bank_account,\n      invoice_book: row.invoice_book,\n      sites: row.sites,\n      note: \"\"\n    },\n    items: [\n      {\n        item_name: row.item_name,\n        item_ammount_unit: row.item_ammount_unit,\n        item_ammount: row.item_ammount,\n        vat: String(row.vat_code),\n        net_unit_price: netAmount,\n        item_note: \"\"\n      }\n    ]\n  }\n};\n\nreturn [{\n  json: fullPayload\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -336,
        -512
      ],
      "id": "78679f44-891e-4fd5-b7b1-8c807da9b6de",
      "name": "Code - create invoce data"
