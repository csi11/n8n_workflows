        "jsCode": "const item = $input.first();\nconst text = item.json.text || '';\n\nconst trackingLinkPattern = /https:\\/\\/ses-track\\.billingo\\.hu\\/CL0\\/([^\\s]+)/;\nconst match = text.match(trackingLinkPattern);\n\nif (!match) {\n  return [{ json: { ...item.json, billingoLink: null, error: 'link not found' } }];\n}\n\nconst decoded = decodeURIComponent(match[1]);\nconst tokenMatch = decoded.match(/document-access\\/([^\\/]+)/);\n\nif (!tokenMatch) {\n  return [{ json: { ...item.json, billingoLink: null, error: 'token not found' } }];\n}\n\nconst token = tokenMatch[1];\nconst downloadUrl = `https://app.billingo.hu/document-access/${token}/download`;\n\nreturn [{ json: { ...item.json, billingoLink: downloadUrl } }];"
