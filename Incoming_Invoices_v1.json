      "parameters": {
        "jsCode": "// Filters items to only those with invoice-related subjects.\n// Avoids false positives like \"Számlakivonat\" (bank statement).\n\nconst includeKeywords = ['szamla', 'bill', 'invoice', 'receipt', 'megrendelesed'];\nconst excludeKeywords = ['szamlakivonat']; // bank statement, not an invoice\n\nfunction normalize(str) {\n  return str\n    .toLowerCase()\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, ''); // strip accents: á->a, é->e, etc.\n}\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  const subject = item.json.subject || '';\n  const normalizedSubject = normalize(subject);\n\n  // split subject into words on any non-letter character\n  const words = normalizedSubject.split(/[^a-z]+/).filter(Boolean);\n\n  const isExcluded = words.some(w =>\n    excludeKeywords.some(ex => w.startsWith(ex))\n  );\n\n  const isMatch = !isExcluded && words.some(w =>\n    includeKeywords.some(kw => w.startsWith(kw))\n  );\n\n  if (isMatch) {\n    results.push(item);\n  }\n}\n\nreturn results;"
      },
