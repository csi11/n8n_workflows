      "parameters": {
        "jsCode": "const excludeKeywords = ['receipt', 'nyugta', 'rendeles', 'aszf', 'gtc', 'order'];\n\nfunction normalize(str) {\n  return str.toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\n}\n\nfunction isExcluded(filename) {\n  const words = normalize(filename || '').split(/[^a-z]+/).filter(Boolean);\n  return words.some(w => excludeKeywords.some(ex => w.startsWith(ex)));\n}\n\nconst item = $input.first();\nconst outputItems = [];\n\nfor (const [key, b] of Object.entries(item.binary || {})) {\n  if (!isExcluded(b.fileName)) {\n    outputItems.push({\n      json: item.json,\n      binary: { data: b }\n    });\n  }\n}\n\nif (outputItems.length === 0) {\n  return [{ json: { ...item.json, allExcluded: true }, binary: {} }];\n}\n\nreturn outputItems;"
      },
